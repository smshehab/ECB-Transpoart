{
  "rules": {
    ".read": false,
    ".write": false,
    "trip_contributors": {
      "$tripId": {
        "$contributorId": {
          ".read": true,
          ".write": "auth != null && root.child('contributor_owners').child($contributorId).val() === auth.uid",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'accuracy', 'updatedAt', 'sessionId', 'status'])",
          "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "speed": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 45)" },
          "heading": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "sessionId": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.val() in ['sharing', 'stopped']" }
        }
      }
    },
    "contributor_owners": {
      "$contributorId": {
        ".read": "auth != null && (data.val() === auth.uid || auth.token.role === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)",
        ".validate": "newData.isString()"
      }
    }
  }
}
